{
  "name": "velina",
  "version": "0.1.0",
  "description": "A small UI to run commands, useful for monorepos.",
  "type": "module",
  "bin": {
    "velina": "./dist/velina"
  },
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "bun server.ts",
    "build": "bun build --compile --production server.ts --outfile dist/velina"
  },
  "dependencies": {
    "antd": "^6.6.5",
    "capnweb": "^0.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.4.0",
    "styled-components": "^6.5.3",
    "swr": "^2.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0"
  }
}
