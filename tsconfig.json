{
  "compilerOptions": {
    "target": "esnext",
    "jsx": "react-jsx",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "#/*": ["./*"]
    },
    "customConditions": ["bun"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  }
}
